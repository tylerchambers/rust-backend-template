# Production Compose inputs. Keep actual values in the deployment environment
# or a private .env (mode 0600). Never commit credentials.

# Full reviewed image reference: registry/repository@sha256:<64 hex digits>.
BACKEND_IMAGE=

# One origin for Caddy's TLS site, API links and origin checks. Point this
# hostname's public DNS at Caddy; use standard HTTPS with no trailing slash.
PUBLIC_ORIGIN=https://app.example.com

# External PostgreSQL DSNs for the same database. Use sslmode=verify-full
# with a trusted server certificate. Only migrate receives the owner DSN.
MIGRATION_DATABASE_URL=
# Use the restricted template_app login, not the migration credential.
DATABASE_URL=

# SMTP submission with verified STARTTLS on port 587 (API and worker).
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional external Redis for API rate limits and caching; omit when unused.
# REDIS_URL=redis://redis.internal:6379/0
