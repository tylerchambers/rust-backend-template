{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build index.html --target=browser --production --outdir=dist --public-path=/assets/",
		"dev": "bun build index.html --target=browser --watch --outdir=dist --public-path=/assets/",
		"check": "bun node_modules/typescript/bin/tsc --noEmit && bun node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@mantine/core": "9.8.2",
		"@mantine/hooks": "9.8.2",
		"@tanstack/react-query": "5.108.4",
		"@tanstack/react-router": "1.170.46",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"rust-backend-template-sdk": "workspace:*",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/react": "19.3.3",
		"@types/react-dom": "19.3.0",
		"typescript": "7.0.2"
	}
}
